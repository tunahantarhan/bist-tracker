# Copy to deploy/.env on the server (never commit it).

# Public host name, its DNS A record must point at the server, e.g. borsa.example.com
DOMAIN=

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Strong random password, only used inside the Docker network
POSTGRES_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=bist_tracker_db

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Alert and account e-mails (skipped while empty)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

SCAN_INTERVAL_MINUTES=5
NOTIFY_ONLY_WHEN_MARKET_OPEN=true
# Bridge holidays announced after the built-in table, comma-separated ISO dates
MARKET_EXTRA_HOLIDAYS=
