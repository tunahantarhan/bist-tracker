PROJECT_NAME="BIST Tracker"
API_V1_STR="/api/v1"

# JWT Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY="change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Apple Silicon Docker Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bist_tracker_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Web (used for links in alert emails and CORS)
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# SMTP (emails are skipped when user/password are empty)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Background scanner
SCAN_INTERVAL_MINUTES=5
# Set to false to receive notifications outside BIST trading hours (local testing)
NOTIFY_ONLY_WHEN_MARKET_OPEN=true
